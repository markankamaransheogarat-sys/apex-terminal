{
  "name": "apex-terminal",
  "version": "1.0.0",
  "description": "Institutional-grade Bloomberg Terminal & BlackRock Aladdin Risk Engine for Crypto & Digital Assets",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "apex": "./bin/apex.js"
  },
  "scripts": {
    "build": "tsc",
    "test": "node --import tsx --test tests/**/*.test.ts tests/**/*.test.js",
    "test:audio": "node --test tests/audio.test.js",
    "terminal": "node --import tsx src/index.ts",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "bloomberg-terminal",
    "blackrock-aladdin",
    "risk-engine",
    "cryptocurrency",
    "value-at-risk",
    "stress-testing",
    "binance-websocket",
    "bybit-websocket"
  ],
  "author": "Principal Systems Architect",
  "license": "Apache-2.0",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.23.15",
    "typescript": "^5.8.2"
  }
}
